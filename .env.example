# AquaGrid Environment Configuration

# LLM Execution Mode:
# 'dev'  -> Local Ollama (qwen3:8b) first (default; saves API credits during development)
# 'demo' -> Groq (70B/8B) and Gemini Flash first (for live presentation speed and quality)
LLM_MODE=dev

# Local Ollama endpoint
OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Cloud API Keys & Models (for demo mode and fallback chains)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_1=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# SQLite Database path
DATABASE_PATH=coastal_water_network.sqlite

# Timeouts & Retries
REQUEST_TIMEOUT=45
MAX_RETRIES=1
